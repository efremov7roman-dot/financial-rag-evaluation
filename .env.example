# Copy this file to .env for local overrides. Never commit .env.
FINANCIAL_RAG_ENVIRONMENT=development
FINANCIAL_RAG_LOG_LEVEL=INFO
FINANCIAL_RAG_DATA_DIR=data

# SEC requires a descriptive User-Agent with contact information.
# Example: FinancialRAG/0.1 research@example.com
FINANCIAL_RAG_SEC_USER_AGENT=
FINANCIAL_RAG_SEC_REQUESTS_PER_SECOND=5
FINANCIAL_RAG_SEC_TIMEOUT_SECONDS=30
FINANCIAL_RAG_SEC_MAX_RETRIES=3

FINANCIAL_RAG_CHUNK_MAX_CHARS=2000
FINANCIAL_RAG_CHUNK_OVERLAP_CHARS=200

FINANCIAL_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FINANCIAL_RAG_EMBEDDING_BATCH_SIZE=64
FINANCIAL_RAG_RETRIEVAL_TOP_K=5
FINANCIAL_RAG_INDEX_DIR=data/index/dense
FINANCIAL_RAG_MODEL_CACHE_DIR=data/models
FINANCIAL_RAG_DENSE_CANDIDATES=30
FINANCIAL_RAG_BM25_CANDIDATES=30
FINANCIAL_RAG_RRF_K=60
FINANCIAL_RAG_RERANK_CANDIDATES=5
FINANCIAL_RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
FINANCIAL_RAG_RERANKER_BATCH_SIZE=32
FINANCIAL_RAG_BM25_K1=1.5
FINANCIAL_RAG_BM25_B=0.75
FINANCIAL_RAG_FACT_INDEX_PATH=data/index/xbrl/facts.jsonl
FINANCIAL_RAG_API_HOST=0.0.0.0
FINANCIAL_RAG_API_PORT=8000
